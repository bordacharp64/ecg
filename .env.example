# ---------------------------------------------------------------------------
# Bibliotheque ECG - IHU Liryc : variables d'environnement
# Copier ce fichier en `.env.local` (developpement) ou les definir chez
# l'hebergeur (production). Ne jamais versionner les valeurs reelles.
# ---------------------------------------------------------------------------

# URL publique du site, sans slash final. Sert a construire les liens
# de connexion envoyes par e-mail.
APP_URL="http://localhost:3000"

# --- Base de donnees (PostgreSQL) ------------------------------------------
DATABASE_URL="postgres://ecg:ecg@localhost:5432/ecg"

# --- Secret de session -----------------------------------------------------
# Genere avec : openssl rand -base64 48
SESSION_SECRET="a-remplacer-par-un-secret-de-48-octets-minimum"

# --- Envoi des e-mails (lien de connexion) ---------------------------------
# Laisser SMTP_HOST vide en developpement : les e-mails sont alors ecrits
# dans la console au lieu d'etre envoyes.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Bibliotheque ECG Liryc <formation@ihu-liryc.fr>"

# --- Stockage des PDF ------------------------------------------------------
# "local" : les fichiers sont lus dans le dossier defini par LOCAL_STORAGE_DIR
# "s3"    : les fichiers sont lus dans un bucket S3 compatible
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./private/livres"

# Uniquement si STORAGE_DRIVER="s3" (Scaleway, OVH, MinIO, AWS...)
S3_ENDPOINT="https://s3.fr-par.scw.cloud"
S3_REGION="fr-par"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Acces a l'espace d'administration -------------------------------------
# Liste d'e-mails, separes par des virgules, autorises a voir /admin.
ADMIN_EMAILS="formation@ihu-liryc.fr"

# --- Filtrage des inscriptions (optionnel) ---------------------------------
# Vide = toute adresse e-mail est acceptee.
# Sinon, liste de domaines autorises separes par des virgules, par ex. :
# ALLOWED_EMAIL_DOMAINS="u-bordeaux.fr,univ-lyon1.fr,etu.sorbonne-universite.fr"
ALLOWED_EMAIL_DOMAINS=""
