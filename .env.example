# ---------------------------------------------------------------------------
# Bibliotheque ECG - IHU Liryc : variables d'environnement
# Copier ce fichier en `.env.local` (developpement) ou les definir chez
# l'hebergeur (production). Ne jamais versionner les valeurs reelles.
# ---------------------------------------------------------------------------

# URL publique du site, sans slash final. Sert a construire les redirections
# et le plan du site.
APP_URL="http://localhost:3000"

# --- Base de donnees (PostgreSQL) ------------------------------------------
DATABASE_URL="postgres://ecg:ecg@localhost:5432/ecg"

# --- Secret de signature du cookie d'identification ------------------------
# 32 caracteres minimum. Genere avec : openssl rand -base64 48
# Le changer deconnecte tous les lecteurs : ils devront remplir la fiche a
# nouveau au prochain telechargement (leurs donnees, elles, sont conservees).
SESSION_SECRET="a-remplacer-par-un-secret-de-48-octets-minimum"

# --- Stockage des PDF ------------------------------------------------------
# "local" : les fichiers sont lus dans le dossier defini par LOCAL_STORAGE_DIR
# "s3"    : les fichiers sont lus dans un bucket S3 compatible
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./private/livres"

# Uniquement si STORAGE_DRIVER="s3" (Scaleway, OVH, MinIO, AWS...).
# Le bucket doit rester PRIVE : le site lit les fichiers avec ses propres
# identifiants et ne publie jamais d'URL directe.
S3_ENDPOINT="https://s3.fr-par.scw.cloud"
S3_REGION="fr-par"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Acces a l'espace d'administration -------------------------------------
# Liste d'e-mails, separes par des virgules. Une personne de cette liste voit
# /admin des lors qu'elle a rempli la fiche d'identification avec cette
# adresse depuis le navigateur qu'elle utilise.
ADMIN_EMAILS="formation@ihu-liryc.fr"
